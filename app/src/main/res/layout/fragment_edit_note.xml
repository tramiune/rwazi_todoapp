<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/editNoteRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <com.rwazi.app.todo.util.RwaziTopBar
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:topBarTitle="@string/edit_note_label" />

    <EditText
        android:id="@+id/etTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/padding_horizontal"
        android:layout_marginTop="@dimen/_16sdp"
        android:background="@null"
        android:hint="@string/title_hint"
        android:inputType="textCapSentences"
        android:justificationMode="inter_word"
        android:maxLines="2"
        android:textColor="?attr/textColorPrimary"
        android:textColorHint="?attr/textColorSecondary"
        style="@style/TextAppearance.ToDoApp.Headline6"
        app:layout_constraintTop_toBottomOf="@+id/topBar" />

    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="@dimen/padding_horizontal"
        android:layout_marginTop="@dimen/_8sdp"
        android:alpha="0.1"
        android:background="?attr/dividerColor"
        app:layout_constraintTop_toBottomOf="@+id/etTitle" />

    <EditText
        android:id="@+id/etContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/padding_horizontal"
        android:layout_marginTop="@dimen/_12sdp"
        android:layout_marginBottom="@dimen/_16sdp"
        android:background="@null"
        android:gravity="top"
        android:hint="@string/start_typing_hint"
        android:inputType="textMultiLine|textCapSentences"
        android:justificationMode="inter_word"
        android:paddingBottom="@dimen/_24sdp"
        android:textAppearance="?attr/textAppearanceBody1"
        android:textColor="?attr/textColorPrimary"
        android:textColorHint="?attr/textColorSecondary"
        app:layout_constraintBottom_toTopOf="@+id/btnUpdate"
        app:layout_constraintTop_toBottomOf="@+id/divider" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnUpdate"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_56sdp"
        android:layout_marginBottom="@dimen/_8sdp"
        android:text="@string/save_changes"
        android:textStyle="bold"
        app:cornerRadius="@dimen/_16sdp"
        android:layout_marginHorizontal="@dimen/padding_horizontal"
        app:elevation="@dimen/_4sdp"
        app:icon="@drawable/ic_add"
        app:iconGravity="textStart"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
